#!/bin/zsh
# tmux-home - Home session with global control
# Special features: clean all, kill all sessions, kill all claude

SESSION_NAME="Home"
PROJECT_PATH="/home/hacker"

# List of project paths for cleaning
PROJECT_PATHS=(
    "/home/hacker/VibeCoding/work/kommu"
    "/home/hacker/VibeCoding/work/DevLensPro"
    "/home/hacker/VibeCoding/work/Formation-AI"
    "/home/hacker/VibeCoding/clients/DentistryGPT"
    "/home/hacker/VibeCoding/clients/Gluten-Libre"
    "/home/hacker/VibeCoding/clients/resonant"
    "/home/hacker/VibeCoding/agentic-os/LifePixels/App"
    "/home/hacker/VibeCoding/agentic-os/SagaForge"
    "/home/hacker/VibeCoding/agentic-os/vision"
    "/home/hacker/VibeCoding/agentic-os/AgentikDev"
    "/home/hacker/VibeCoding/agentic-os/Agentik-Claude"
    "/home/hacker/VibeCoding/1-life"
)

# List existing Home sessions
existing=($(tmux ls 2>/dev/null | grep -E "^${SESSION_NAME}(-[0-9]+)?:" | cut -d: -f1))

# Count other sessions (not Home)
other_sessions=($(tmux ls 2>/dev/null | grep -vE "^${SESSION_NAME}(-[0-9]+)?:" | cut -d: -f1))

# If no Home session → create directly
if [[ ${#existing[@]} -eq 0 ]]; then
    echo "📁 Creating session $SESSION_NAME..."
    tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_PATH"
    tmux attach -t "$SESSION_NAME"
    exit 0
fi

# Display menu
show_menu() {
    clear
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  🏠 HOME - Control Center                                ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    echo " Home Sessions:"
    echo " ──────────────"
    i=1
    for s in "${existing[@]}"; do
        wins=$(tmux list-windows -t "$s" 2>/dev/null | wc -l)
        echo "   $i) $s  │ $wins win"
        ((i++))
    done

    if [[ ${#other_sessions[@]} -gt 0 ]]; then
        echo ""
        echo " Other active sessions: ${#other_sessions[@]}"
        for s in "${other_sessions[@]}"; do
            echo "   • $s"
        done
    fi

    # Count claude processes
    claude_count=$(pgrep -f "claude" 2>/dev/null | wc -l)

    echo ""
    echo " ═══════════════════════════════════════════════════════════"
    echo ""
    echo " Actions:"
    echo " ────────"
    echo "   N) ➕ New Home session"
    echo "   D) 🗑️  Delete a Home session"
    echo ""
    echo " Global Actions:"
    echo " ───────────────"
    echo "   C) 🧹 Clean cache ALL projects + RAM (safe, keeps Claude data)"
    echo "   X) 💀 Kill ALL Claude Code processes ($claude_count active)"
    echo "   K) ⚠️  Close ALL other sessions (keeps Home)"
    echo "  KK) ☢️  NUCLEAR: Close ALL (sessions + Claude) except Home"
    echo ""
    echo "   Q) ❌ Cancel"
    echo ""
    echo -n " ➤ "
}

show_menu
read choice
choice_lower="${choice:l}"

case "$choice_lower" in
    [1-9])
        idx=$((choice_lower))
        if [[ $idx -le ${#existing[@]} ]]; then
            sess="${existing[$idx]}"
            echo ""
            echo "🔗 Attaching to $sess..."
            sleep 0.3
            tmux attach -t "$sess"
        else
            echo "❌ Invalid choice"
        fi
        ;;
    n)
        # Find next number
        max=0
        for s in "${existing[@]}"; do
            if [[ "$s" == "$SESSION_NAME" ]]; then
                [[ 1 -gt $max ]] && max=1
            elif [[ "$s" =~ ^${SESSION_NAME}-([0-9]+)$ ]]; then
                num="${match[1]}"
                [[ $num -ge $max ]] && max=$((num + 1))
            fi
        done
        [[ $max -eq 0 ]] && suffix="" || suffix="-$max"
        new_name="${SESSION_NAME}${suffix}"
        echo ""
        echo "📁 Creating $new_name..."
        tmux new-session -d -s "$new_name" -c "$PROJECT_PATH"
        sleep 0.3
        tmux attach -t "$new_name"
        ;;
    d)
        echo ""
        echo " Which session to delete?"
        i=1
        for s in "${existing[@]}"; do
            echo "   $i) $s"
            ((i++))
        done
        echo ""
        echo -n " ➤ "
        read del_choice
        if [[ "$del_choice" =~ ^[0-9]+$ ]] && [[ $del_choice -le ${#existing[@]} ]] && [[ $del_choice -ge 1 ]]; then
            sess="${existing[$del_choice]}"
            tmux kill-session -t "$sess" 2>/dev/null
            echo " ✓ Session $sess deleted"
            sleep 1
            exec "$0"
        else
            echo " ❌ Invalid choice"
        fi
        ;;
    c)
        echo ""
        echo " 🧹 Cleaning ALL projects + RAM..."
        echo " 🛡️  SAFE: ~/.claude/ and project .claude/ will NOT be touched"
        echo ""

        total_cleaned=0

        for proj_path in "${PROJECT_PATHS[@]}"; do
            if [[ -d "$proj_path" ]]; then
                proj_name=$(basename "$proj_path")
                cleaned=0

                # npm/bun cache
                if [[ -d "$proj_path/node_modules/.cache" ]]; then
                    size=$(du -sm "$proj_path/node_modules/.cache" 2>/dev/null | cut -f1)
                    rm -rf "$proj_path/node_modules/.cache"
                    cleaned=$((cleaned + size))
                fi

                # Next.js cache
                if [[ -d "$proj_path/.next/cache" ]]; then
                    size=$(du -sm "$proj_path/.next/cache" 2>/dev/null | cut -f1)
                    rm -rf "$proj_path/.next/cache"
                    cleaned=$((cleaned + size))
                fi

                # Turbo cache
                if [[ -d "$proj_path/.turbo" ]]; then
                    size=$(du -sm "$proj_path/.turbo" 2>/dev/null | cut -f1)
                    rm -rf "$proj_path/.turbo"
                    cleaned=$((cleaned + size))
                fi

                # ESLint cache
                if [[ -f "$proj_path/.eslintcache" ]]; then
                    rm -f "$proj_path/.eslintcache"
                fi

                # TypeScript buildinfo
                rm -f "$proj_path/tsconfig.tsbuildinfo" 2>/dev/null
                rm -rf "$proj_path/.tsbuildinfo" 2>/dev/null

                if [[ $cleaned -gt 0 ]]; then
                    echo " ✓ $proj_name: ${cleaned}MB freed"
                    total_cleaned=$((total_cleaned + cleaned))
                fi
            fi
        done

        echo ""
        echo " System cleanup..."

        # npm global cache
        npm cache clean --force 2>/dev/null && echo " ✓ npm global cache"

        # bun cache
        bun pm cache rm 2>/dev/null && echo " ✓ bun cache"

        # RAM
        ram_before=$(free -m | awk '/^Mem:/{print $3}')
        sync
        echo 3 | sudo tee /proc/sys/vm/drop_caches > /dev/null 2>&1
        ram_after=$(free -m | awk '/^Mem:/{print $3}')
        ram_freed=$((ram_before - ram_after))
        [[ $ram_freed -gt 0 ]] && echo " ✓ RAM: ${ram_freed}MB freed"

        echo ""
        echo " ═══════════════════════════════════════════════════════════"
        echo " 📊 Total project cache: ${total_cleaned}MB freed"
        free -h | awk '/^Mem:/{printf " 📊 RAM: %s used / %s total\n", $3, $2}'
        df -h / | tail -1 | awk '{print " 📊 Disk: "$3" / "$2" ("$5")"}'
        echo ""
        echo " 🛡️  PRESERVED: ~/.claude/ (all conversations & config)"
        echo " ═══════════════════════════════════════════════════════════"
        echo ""
        sleep 3
        exec "$0"
        ;;
    x)
        echo ""
        claude_pids=$(pgrep -f "claude" 2>/dev/null)
        if [[ -z "$claude_pids" ]]; then
            echo " No active Claude Code processes."
        else
            count=$(echo "$claude_pids" | wc -l)
            echo " ⚠️  Kill $count Claude Code processes? (y/n)"
            echo -n " ➤ "
            read confirm
            if [[ "${confirm:l}" == "y" || "${confirm:l}" == "yes" ]]; then
                echo "$claude_pids" | xargs kill -9 2>/dev/null
                echo " ✓ $count Claude Code processes killed"
            else
                echo " Cancelled."
            fi
        fi
        sleep 2
        exec "$0"
        ;;
    k)
        if [[ ${#other_sessions[@]} -eq 0 ]]; then
            echo " No other sessions to close."
            sleep 1
            exec "$0"
        fi
        echo ""
        echo " ⚠️  WARNING ⚠️"
        echo ""
        echo " This will close ${#other_sessions[@]} session(s):"
        for s in "${other_sessions[@]}"; do
            echo "   • $s"
        done
        echo ""
        echo " Home sessions will be kept."
        echo ""
        echo " Confirm? (y/n)"
        echo -n " ➤ "
        read confirm
        if [[ "${confirm:l}" == "y" || "${confirm:l}" == "yes" ]]; then
            for s in "${other_sessions[@]}"; do
                tmux kill-session -t "$s" 2>/dev/null
                echo " ✓ $s closed"
            done
            echo ""
            echo " ✅ All other sessions closed."
        else
            echo " Cancelled."
        fi
        sleep 2
        exec "$0"
        ;;
    kk)
        echo ""
        echo " ╔═══════════════════════════════════════════════════════════╗"
        echo " ║  ☢️☢️☢️ NUCLEAR OPTION ☢️☢️☢️                              ║"
        echo " ╚═══════════════════════════════════════════════════════════╝"
        echo ""
        echo " This will:"
        echo "   • Kill ALL Claude Code processes"
        echo "   • Close ALL tmux sessions (except Home)"
        echo ""
        if [[ ${#other_sessions[@]} -gt 0 ]]; then
            echo " Sessions that will be closed:"
            for s in "${other_sessions[@]}"; do
                echo "   💀 $s"
            done
        fi
        claude_count=$(pgrep -f "claude" 2>/dev/null | wc -l)
        echo ""
        echo " Active Claude Code: $claude_count"
        echo ""
        echo " 🛡️  SAFE: ~/.claude/ will NOT be touched"
        echo ""
        echo " Confirm? (y/n)"
        echo -n " ➤ "
        read confirm
        if [[ "${confirm:l}" == "y" || "${confirm:l}" == "yes" ]]; then
            echo ""
            echo " 💀 Executing..."

            # Kill all Claude processes
            pkill -9 -f "claude" 2>/dev/null
            echo " ✓ Claude processes killed"

            # Kill all other tmux sessions
            for s in "${other_sessions[@]}"; do
                tmux kill-session -t "$s" 2>/dev/null
                echo " ✓ Session $s closed"
            done

            echo ""
            echo " ✅ NUCLEAR complete. Only Home survives."
        else
            echo " Cancelled."
        fi
        sleep 2
        exec "$0"
        ;;
    q|"")
        echo " Cancelled."
        ;;
    *)
        echo " ❌ Invalid choice"
        sleep 1
        exec "$0"
        ;;
esac
